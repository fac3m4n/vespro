# Copy to .env.local and fill in. Never commit .env.local — this repo is public.

# ---------------------------------------------------------------------------
# Arkiv (Tiramisu testnet)
# Faucet: https://hub.arkiv.network/faucet   Explorer: https://tiramisu.explorer.arkiv.network
# ---------------------------------------------------------------------------
# Two burner wallets, both funded from the faucet, so a listing is owned by the
# seller's wallet and a grant by the buyer's. Never personal keys.
# No NEXT_PUBLIC_ prefix: that would ship them into the browser bundle.
#
# Do NOT use the shared key printed in the Arkiv SDK README. It is public, so
# anything it owns can be spent or overwritten by anyone who read those docs.
ARKIV_OWNER_PRIVATE_KEY=
ARKIV_BUYER_PRIVATE_KEY=

# Public RPC endpoints. The websocket one is what keeps Mission 03 a real
# subscription instead of a silent one-second poll.
NEXT_PUBLIC_ARKIV_RPC_HTTP=https://rpc.tiramisu.db-chain.testnet.arkiv.network
NEXT_PUBLIC_ARKIV_RPC_WS=wss://rpc.tiramisu.db-chain.testnet.arkiv.network

# ---------------------------------------------------------------------------
# Swarm
# ---------------------------------------------------------------------------
# Bearer credential from the Swarm desk. Anyone who reads it can spend it.
SWARM_GIFT_CODE=
NEXT_PUBLIC_SWARM_GATEWAY=https://download.gateway.ethswarm.org
NEXT_PUBLIC_SWARM_POSTAGE_BATCH_ID=

# ---------------------------------------------------------------------------
# Avalanche Fuji (stretch goal — settlement contract)
# Faucet: https://core.app/tools/testnet-faucet/
# ---------------------------------------------------------------------------
# Burner keys, funded from the Core faucet. Settlement is skipped (and says so)
# when these are unset, so the app runs without them.
FUJI_DEPLOYER_PRIVATE_KEY=
FUJI_BUYER_PRIVATE_KEY=
NEXT_PUBLIC_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_LICENCE_CONTRACT_ADDRESS=
